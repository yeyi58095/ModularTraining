# Local experiments: never sync checkpoints or full diagnostics through Git.
sessions/
+trainingmodels/*/runs/
# Track only plan definitions and each run's bounded report, never raw runs.
/experiments/*
!/experiments/*/
/experiments/*/*
!/experiments/*/curriculum.json
!/experiments/*/runs/
/experiments/*/runs/*
!/experiments/*/runs/*/
/experiments/*/runs/*/*
!/experiments/*/runs/*/reports/
/experiments/*/runs/*/reports/*
!/experiments/*/runs/*/reports/report.json
training_diagnostics/
/diagnostic_packages/
runtime/training_runs_parallel_checkpointed/
checkpoints/
attempt_*/
*.log
*.mat
reward_history.png
reward_history.csv

# MATLAB / Simulink generated files (keep source .m and .slx).
slprj/
*.slxc
*.asv
*.autosave
*_rtw/

# Python and verification output.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
tests/output/

# Meeting authoring intermediates and duplicate unpacked offline resources.
/.meeting-build/
/output/meeting_training_20261014/
/output/Meeting_Training_20261014_Offline.zip
/output/meeting_training_labstyle_20261014/docs/
/output/meeting_training_labstyle_20261014/assets/

# Share only the bounded exporter output, not arbitrary files under reports.
/reports/*
!/reports/README.md
!/reports/*/
/reports/*/*
!/reports/*/*/
/reports/*/*/*
!/reports/*/*/report.json
