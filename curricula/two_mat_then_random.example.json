{
  "schema_version": 1,
  "model": "ppo_lstm128",
  "stages": [
    {
      "id": "trajectory_one",
      "trajectory": {
        "type": "mat",
        "file": "../trajectories/軌跡1.mat",
        "waypoints_variable": "waypoints",
        "velocity_variable": "velocity"
      },
      "wind": {
        "east_mps": [
          0,
          0
        ],
        "north_mps": [
          0,
          0
        ],
        "turbulence": [
          0,
          0
        ]
      },
      "advance_when": {
        "all": [
          {
            "metric": "stage_episodes",
            "at_least": 5000
          },
          {
            "metric": "reward_mean",
            "window": 100,
            "consecutive_windows": 3,
            "at_least": 2500
          }
        ]
      },
      "max_episodes": 20000,
      "on_limit": "pause"
    },
    {
      "id": "trajectory_two",
      "trajectory": {
        "type": "mat",
        "file": "../trajectories/軌跡2.mat",
        "waypoints_variable": "waypoints",
        "velocity_variable": "velocity"
      },
      "wind": {
        "east_mps": [
          -1,
          1
        ],
        "north_mps": [
          -1,
          1
        ],
        "turbulence": [
          0,
          1
        ]
      },
      "advance_when": {
        "all": [
          {
            "metric": "stage_episodes",
            "at_least": 5000
          },
          {
            "metric": "full_length_rate",
            "steps_at_least": 3000,
            "window": 100,
            "consecutive_windows": 3,
            "at_least": 0.9
          }
        ]
      },
      "max_episodes": 20000,
      "on_limit": "pause"
    },
    {
      "id": "random_paths",
      "trajectory": {
        "type": "random",
        "refresh_every_worker_episodes": 10
      },
      "wind": {
        "east_mps": [
          -3,
          3
        ],
        "north_mps": [
          -3,
          3
        ],
        "turbulence": [
          0,
          2
        ]
      },
      "advance_when": {
        "all": [
          {
            "metric": "stage_episodes",
            "at_least": 5000
          },
          {
            "metric": "reward_mean",
            "window": 100,
            "consecutive_windows": 3,
            "at_least": 2750
          }
        ]
      },
      "max_episodes": 75000,
      "on_limit": "pause"
    }
  ]
}
