  "cards": [
    {
      "dot": "cyan",
      "title": "以課程管理實驗",
      "items": [
        "experiments/<課程>/runs/<實驗>/；模型是課程參數。",
        "舊位置可原位續訓；遷移後由新位置接續。"
      ]
    },
    {
      "dot": "amber",
      "title": "建池成功後才開始訓練",
      "items": [
        "lab_gpu6：最多 6、最低 1；失敗後備援 4 → 2 → 1。",
        "已連線部分 workers 不等於可用 pool；STOP 保留已存檔進度。"
      ]
    },
    {
      "dot": "emerald",
      "title": "條件驅動與保存後暫停",
      "items": [
        "一般每段 1000；恢復每段 100，最多新增 1000 回合。",
        "啟用 guard 後可暫停疑似退步；不自動回滾。"
      ]
    }
  ]
